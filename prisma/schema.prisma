generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id    Int    @id @default(autoincrement())
  nome  String @unique @db.VarChar(30)
  pecas Peca[]

  @@map("categorias")
}

enum CondicaoPeca {
  NOVA
  SEMINOVA
  USADA
  COM_AVARIAS
}

model Peca {
  id               Int          @id @default(autoincrement())
  descricao        String       @db.VarChar(60)
  marca            String?      @db.VarChar(30)
  tamanho          String       @db.VarChar(5)
  preco            Decimal      @db.Decimal(10, 2)
  foto             String
  detalhes         String?
  condicao         CondicaoPeca @default(SEMINOVA)
  destaque         Boolean      @default(true)

  // Campos preenchidos automaticamente pela IA (Gemini) após o cadastro
  materialProvavel String?
  dicasCuidado     String?
  epocaEstimada    String?
  avaliacaoIA      DateTime?

  categoria        Categoria    @relation(fields: [categoriaId], references: [id])
  categoriaId      Int

  propostas        Proposta[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt()

  @@map("pecas")
}

model Cliente {
  id        String     @id @default(uuid())
  nome      String     @db.VarChar(60)
  email     String     @unique @db.VarChar(80)
  senha     String
  cidade    String?    @db.VarChar(40)

  propostas Proposta[]
  ofertas   OfertaVenda[]

  createdAt DateTime   @default(now())

  @@map("clientes")
}

model Admin {
  id    Int    @id @default(autoincrement())
  nome  String @db.VarChar(60)
  email String @unique @db.VarChar(80)
  senha String

  @@map("admins")
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
}

model Proposta {
  id           Int            @id @default(autoincrement())
  mensagem     String
  resposta     String?
  status       StatusProposta @default(PENDENTE)

  peca         Peca           @relation(fields: [pecaId], references: [id])
  pecaId       Int

  cliente      Cliente        @relation(fields: [clienteId], references: [id])
  clienteId    String

  createdAt    DateTime       @default(now())
  respondidoEm DateTime?

  @@map("propostas")
}

// Cliente oferece uma peça para o brechó comprar ("Quero vender")
model OfertaVenda {
  id            Int            @id @default(autoincrement())
  descricao     String         @db.VarChar(60)
  marca         String?        @db.VarChar(30)
  tamanho       String         @db.VarChar(5)
  precoDesejado Decimal        @db.Decimal(10, 2)
  foto          String
  detalhes      String?
  condicao      CondicaoPeca   @default(USADA)
  resposta      String?
  status        StatusProposta @default(PENDENTE)

  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  clienteId     String

  createdAt     DateTime       @default(now())
  respondidoEm  DateTime?

  @@map("ofertas_venda")
}
