generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id    Int    @id @default(autoincrement())
  nome  String @unique @db.VarChar(30)
  pecas Peca[]

  @@map("categorias")
}

enum CondicaoPeca {
  NOVA
  SEMINOVA
  USADA
  COM_AVARIAS
}

// Ciclo de vida de um anúncio (venda direta entre clientes):
// PENDENTE (aguarda aprovação do admin) -> DISPONIVEL -> RESERVADA (alguém comprou/teve
// proposta aceita) -> VENDIDA (vendedor confirmou). REPROVADA = admin recusou o anúncio.
enum StatusAnuncio {
  PENDENTE
  DISPONIVEL
  RESERVADA
  VENDIDA
  REPROVADA
}

model Peca {
  id               Int          @id @default(autoincrement())
  descricao        String       @db.VarChar(60)
  marca            String?      @db.VarChar(30)
  tamanho          String       @db.VarChar(5)
  preco            Decimal      @db.Decimal(10, 2)
  foto             String
  detalhes         String?
  condicao         CondicaoPeca @default(SEMINOVA)
  destaque         Boolean      @default(true)

  // Campos preenchidos automaticamente pela IA (Gemini) após o cadastro
  materialProvavel String?
  dicasCuidado     String?
  epocaEstimada    String?
  avaliacaoIA      DateTime?

  categoria        Categoria    @relation(fields: [categoriaId], references: [id])
  categoriaId      Int

  // Venda direta: quem anuncia (vendedor) e quem compra (comprador).
  // vendedorId nulo = peça da casa ("Brechó do Gogó").
  status           StatusAnuncio @default(DISPONIVEL)
  motivoReprovacao String?
  precoFinal       Decimal?     @db.Decimal(10, 2)
  vendidaEm        DateTime?
  vendedor         Cliente?     @relation("Anuncios", fields: [vendedorId], references: [id])
  vendedorId       String?
  comprador        Cliente?     @relation("Compras", fields: [compradorId], references: [id])
  compradorId      String?

  propostas        Proposta[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt()

  @@map("pecas")
}

model Cliente {
  id        String     @id @default(uuid())
  nome      String     @db.VarChar(60)
  email     String     @unique @db.VarChar(80)
  senha     String
  cidade    String?    @db.VarChar(40)

  propostas Proposta[]
  anuncios  Peca[]     @relation("Anuncios")
  compras   Peca[]     @relation("Compras")

  createdAt DateTime   @default(now())

  @@map("clientes")
}

model Admin {
  id    Int    @id @default(autoincrement())
  nome  String @db.VarChar(60)
  email String @unique @db.VarChar(80)
  senha String

  @@map("admins")
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
}

model Proposta {
  id           Int            @id @default(autoincrement())
  mensagem     String
  valorOferta  Decimal?       @db.Decimal(10, 2)
  resposta     String?
  status       StatusProposta @default(PENDENTE)

  peca         Peca           @relation(fields: [pecaId], references: [id])
  pecaId       Int

  cliente      Cliente        @relation(fields: [clienteId], references: [id])
  clienteId    String

  createdAt    DateTime       @default(now())
  respondidoEm DateTime?

  @@map("propostas")
}
